        "editorBracketMatch.border": "#4888ac",
        "editorGroupHeader.tabsBackground": "#f2f7f9",
        "editorGroupHeader.tabsBorder": "#f2f7f9",
        "editorGutter.background": "#f2f7f9",
        "editorHoverWidget.background": "#e2ebf0",
        "editorHoverWidget.border": "#4888ac",
        "editorIndentGuide.activeBackground1": "#258b42",
        "editorIndentGuide.background1": "#ebf2f6",
        "editorLineNumber.foreground": "#4888ac",
        "editorStickyScroll.background": "#f2f7f9",
        "editorStickyScroll.border": "#4888ac",
        "editorWidget.background": "#e2ebf0",
        "editorWidget.border": "#4888ac",
        "editorWidget.foreground": "#4888ac",
        "editorWidget.resizeBorder": "#4888ac",
        "foreground": "#4888ac",
        "gitDecoration.addedResourceForeground": "#579c36",
        "gitDecoration.untrackedResourceForeground": "#bab847",
        "input.background": "#f2f7f9",
        "input.border": "#4888ac",
        "input.foreground": "#4888ac",
        "inputOption.hoverBackground": "#e2ebf0",
        "list.activeSelectionBackground": "#4888ac",
        "list.activeSelectionForeground": "#f2f7f9",
        "list.activeSelectionIconForeground": "#f2f7f9",
        "list.focusBackground": "#4888ac",
        "list.focusForeground": "#f2f7f9",
        "list.focusOutline": "#4888ac",
        "list.hoverForeground": "#f2f7f9",
        "list.inactiveSelectionBackground": "#ebf2f6",
        "list.inactiveSelectionForeground": "#2f6d91",
        "menu.background": "#f2f7f9",
        "panel.background": "#f2f7f9",
        "panel.border": "#4888ac",
        "panelInput.border": "#e2ebf0",
        "panelSection.dropBackground": "#4888ac",
        "panelSectionHeader.border": "#4888ac",
        "sideBar.background": "#f2f7f9",
        "sideBar.border": "#4686ac",
        "sideBar.foreground": "#4888ac",
        "sideBarSectionHeader.background": "#f2f7f9",
        "sideBarSectionHeader.border": "#f2f7f9",
        "sideBarSectionHeader.foreground": "#4888ac",
        "sideBarTitle.foreground": "#2f6d91",
        "tab.activeBackground": "#f2f7f9",
        "tab.activeBorder": "#579c36",
        "tab.activeBorderTop": "#579c36",
        "tab.activeForeground": "#4888ac",
        "tab.border": "#f2f7f9",
        "tab.inactiveBackground": "#e2ebf0",
        "tab.inactiveForeground": "#4888ac",
        "titleBar.activeBackground": "#f2f7f9",
        "titleBar.activeForeground": "#4888ac",
        "titleBar.border": "#4888ac",
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "support.type.property-name.json", // dit is iets leuks
                "settings": {
                    "foreground": "#4888ac",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "string",
                "settings": {
                    "foreground": "#579c36"
                }
            },
            {
                "scope": "comment",
                "settings": {
                    "foreground": "#a6a455",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": "keyword",
                "settings": {
                    "foreground": "#c99541",
                    "fontStyle": "bold"
                }
            },
        ]
    }
}
